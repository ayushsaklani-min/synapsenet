{
  "version": 2,
  "builds": [
    {
      "src": "synapsenet-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/synapsenet-frontend/$1"
    }
  ],
  "env": {
    "VITE_WS_URL": "wss://synapsenet-backend-45hz.onrender.com",
    "VITE_API_URL": "https://synapsenet-backend-45hz.onrender.com"
  }
}
