{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "downlevelIteration": true,
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["./src"]
}
