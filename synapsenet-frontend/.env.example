# SynapseNet Frontend Environment Variables
# Copy this file to .env.local for local development

# WebSocket URL for real-time data connection
VITE_WS_URL=ws://localhost:8090

# API URL for backend services
VITE_API_URL=http://localhost:8090

# Chainlink Oracle Contract Address (Polygon Amoy)
VITE_CHAINLINK_CONTRACT=0x9b8e6d8b2417116f4ff9bc4e9b9f91a8a7d2f8e5

# Polygon Amoy RPC URL
VITE_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# Production URLs (for Vercel deployment)
# VITE_WS_URL=wss://synapsenet-backend-45hz.onrender.com
# VITE_API_URL=https://synapsenet-backend-45hz.onrender.com
