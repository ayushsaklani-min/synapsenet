# SynapseNet Environment Configuration

# Chainlink Oracle Configuration
CHAINLINK_CONTRACT=0x9b8e6d8b2417116f4ff9bc4e9b9f91a8a7d2f8e5
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
SEPOLIA_RPC=https://ethereum-sepolia.publicnode.com

# For better performance, use dedicated RPC endpoints:
# POLYGON_AMOY_RPC=https://polygon-amoy.infura.io/v3/YOUR_INFURA_KEY
# SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Linera Configuration
LINERA_RPC=http://localhost:8080
ENABLE_LINERA=true
LINERA_WALLET=$HOME/.config/linera/wallet.json
LINERA_STORAGE=rocksdb:$HOME/.config/linera/client.db

# Service Ports
PORT=3001
WS_PORT=8090

# Node Environment
NODE_ENV=development

# Frontend Configuration (for .env in synapsenet-frontend/)
VITE_WS_URL=ws://localhost:8090
VITE_LINERA_GRAPHQL=http://localhost:8080/graphql

# Logging
RUST_LOG=info
DEBUG=

# Performance Tuning
CACHE_TIMEOUT=5000
PRICE_UPDATE_INTERVAL=1000
SCORE_UPDATE_INTERVAL=3000
